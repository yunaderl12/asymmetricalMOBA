--- !u!114 &2079643958
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2079643956}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e7cf67fefa8184ee38bb6092ff456a38, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  root: {fileID: 1212267927}
  text: {fileID: 618798754}
  commands: "=== Debug Commands ===\n\n[\u52C7\u8005\u5074]\n  X            : Exp
    +50\n  N            : \u9B54\u738B\u57CE\u30B3\u30A2\u5373\u6B7B  (\u52C7\u8005\u52DD\u5229\u30C6\u30B9\u30C8)\n 
    B            : StartTown\u30B3\u30A2\u5373\u6B7B (\u9B54\u738B\u52DD\u5229\u30C6\u30B9\u30C8)\n 
    F            : PowerItem \u5F37\u5236\u30B9\u30DD\u30FC\u30F3\n  Backspace   
    : \u843D\u4E0B\u6642\u30EA\u30B9\u30DD\u30FC\u30F3\n\n[\u9B54\u738B\u5074 / \u6E96\u5099\u4E2D]\n 
    Y            : \u6E96\u5099\u30D5\u30A7\u30FC\u30BA\u5373\u7D42\u4E86\n  M           
    : MP\u6D88\u8CBB\u30C6\u30B9\u30C8 (-20)\n  K            : \u9B54\u738B\u30BB\u30EB\u30D5\u30C0\u30E1\u30FC\u30B8
    (-50)\n\n[\u64CD\u4F5C\u7CFB]\n  WASD / Space : \u79FB\u52D5 / \u30B8\u30E3\u30F3\u30D7\n 
    Mouse        : \u8996\u70B9\n  Left Click   : \u901A\u5E38\u653B\u6483\n  Right
    Click  : \u30B9\u30AD\u30EB\u767A\u52D5\n  Left Shift   : \u30B9\u30AD\u30EB\u9078\u629E\u30DB\u30A4\u30FC\u30EB
    (\u62BC\u4E0B\u4E2D)\n  Esc          : \u30AB\u30FC\u30BD\u30EB\u30ED\u30C3\u30AF\u5207\u66FF\n\n[UI]\n 
    9            : \u8996\u91CE\u5224\u5B9A\u30EA\u30F3\u30B0 \u8868\u793A/\u975E\u8868\u793A\n 
    0            : \u3053\u306E\u30A6\u30A3\u30F3\u30C9\u30A6\u8868\u793A/\u975E\u8868\u793A"
